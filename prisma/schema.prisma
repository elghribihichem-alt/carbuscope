// CarbuScope — « Waze du Carburant » Tunisie
// Schema de données : stations, enseignes, services, alertes, mouvements,
// statistiques gouvernorats, axes routiers, projets d'infrastructure,
// avis, contributions communautaires, rapports et calculs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  color          String
  isIndependents Boolean   @default(false)
  stations       Station[]
}

model Station {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  brandId      String?
  brand        Brand?            @relation(fields: [brandId], references: [id])
  gouvernorat  String
  delegation   String
  address      String
  lat          Float
  lng          Float
  status       String            @default("ACTIVE") // ACTIVE | RENOVATION | PROJECT | CLOSED
  traffic      Int               @default(0) // véhicules/jour captifs
  open24       Boolean           @default(false)
  open7j       Boolean           @default(false)
  rating       Float             @default(0)
  reviewsCount Int               @default(0)
  photoUrl     String?
  lastVerified DateTime          @default(now())
  verifiedBy   String            @default("")
  services     StationService[]
  reviews      Review[]
  history      StationHistory[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Service {
  id       String            @id @default(cuid())
  slug     String            @unique
  name     String
  icon     String            @default("circle")
  stations StationService[]
}

model StationService {
  stationId String
  serviceId String
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([stationId, serviceId])
}

model StationHistory {
  id        String   @id @default(cuid())
  stationId String
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String
  newValue  String
  author    String
  source    String   @default("Enseigne") // Enseigne | Agent terrain | Utilisateur | Plateforme
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  stationId String
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  comment   String
  criteria  Json? // { propreté, accueil, rapidité, services }
  createdAt DateTime @default(now())
  // Réponse officielle de l'enseigne (C.2.6+ — gestion de la réputation)
  replyText String?
  repliedAt DateTime?
  repliedBy String?
}

model Alert {
  id          String   @id @default(cuid())
  type        String // OPENING | RENOVATION | REBRAND | INFRA | REGULATORY
  severity    String // CRITICAL | MEDIUM | INFO
  title       String
  description String
  brand       String
  gouvernorat String
  date        DateTime
  impact      String // Fort | Moyen | Faible
  stationCode String?
  read        Boolean  @default(false)
}

model Movement {
  id          String   @id @default(cuid())
  date        DateTime
  type        String // OPENING | RENOVATION | CLOSURE | REBRAND
  brand       String
  station     String
  gouvernorat String
  impact      String
}

model GovernoratStat {
  id               String @id @default(cuid())
  name             String @unique
  population       Int
  vehicles         Int
  motorizationRate Float
  avgFleetAge      Float
  delegationCount  Int
}

model RoadAxis {
  id              String @id @default(cuid())
  code            String
  name            String
  type            String // AUTOROUTE | RN | GP
  tmj             Int // trafic moyen journalier
  heavyVehiclePct Float
  segments        Json // [[lng, lat], ...]
}

model InfraProject {
  id          String @id @default(cuid())
  name        String
  type        String // AUTOROUTE | ECHANGEUR | ZONE_INDUSTRIELLE | PORT | ROUTE
  status      String // CONSTRUCTION | PLANIFIE
  budget      String
  targetDate  String
  description String
  lat         Float
  lng         Float
}

model Report {
  id          String   @id @default(cuid())
  name        String
  type        String // CONCURRENCE | IMPLANTATION | PERFORMANCE | VEILLE
  period      String
  scope       String
  format      String // PDF | Excel | PowerPoint
  status      String   @default("GENERATED")
  generatedBy String
  sizeKb      Int      @default(0)
  createdAt   DateTime @default(now())
}

model ReportSchedule {
  id        String   @id @default(cuid())
  name      String
  type      String // WEEKLY | MONTHLY | REALTIME
  target    String
  channel   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Veille automatisée des notes (C.2.6+) : alerte email programmée déclenchée
// lorsqu'une station chute de seuil points (règle watchlist de /api/stats/reputation).
model WatchlistAlert {
  id              String    @id @default(cuid())
  brandSlug       String
  scope           String // "ALL" (toute la watchlist) ou code d'une station
  stationLabel    String // libellé lisible (nom de la station ou « Toute la watchlist »)
  thresholdPoints Float     @default(0.8)
  frequency       String // IMMEDIATE | DAILY | WEEKLY
  email           String
  active          Boolean   @default(true)
  triggerCount    Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
}

// Moteur périodique de veille (C.2.6+) : trace chaque passe d'évaluation des
// alertes programmées. En production : cron planifié ; en démo : passe
// déclenchable manuellement depuis le back-office + historique seedé.
model AlertRun {
  id              String   @id @default(cuid())
  ranAt           DateTime @default(now())
  mode            String   @default("MANUAL") // MANUAL | SCHEDULED
  brandsCovered   Int      @default(0)
  evaluatedAlerts Int      @default(0) // alertes dues évaluées contre la watchlist
  triggeredAlerts Int      @default(0) // alertes ayant déclenché un email
  skippedAlerts   Int      @default(0) // alertes non dues (fréquence déjà honorée)
  stationsFlagged Int      @default(0) // stations signalées, cumul des alertes déclenchées
  emailsQueued    Int      @default(0) // emails simulés mis en file
  durationMs      Int      @default(0)
  details         Json? // détail par alerte (statut, exemples, email tel qu'envoyé)
}

// Notifications in-app enseigne (C.2.6+) : écrites par le moteur de veille au
// moment où un email part, consultées depuis le portail (cloche + centre de
// notifications). Boucle de fermeture : email simulé + badge portail.
model Notification {
  id           String   @id @default(cuid())
  brandSlug    String
  kind         String   @default("WATCHLIST") // WATCHLIST | SYSTEM | DECREE
  title        String
  body         String
  stationLabel String? // station ou périmètre concerné
  deltaPoints  Float? // chute constatée (pt)
  alertRunId   String? // passe du moteur à l'origine
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// Observatoire des prix du carburant (T22) : en Tunisie les prix pompe sont
// fixés par décret ministériel, identiques sur tout le territoire — la série
// historique trace chaque décret (prix pompe + marge détaillant réglementée).
// Alimente l'onglet B2B « Prix & marges », la bannière mobile B2C et la
// référence du signalement « Prix anormal » (B.2.5).
model FuelPrice {
  id            String   @id @default(cuid())
  fuelType      String // ESSENCE | GAZOLE | GPL
  priceMillimes Int // prix pompe, millimes/L (ou /kg pour GPL)
  marginMillimes Int // marge détaillant réglementée, millimes/L
  effectiveAt   DateTime // date d'application du décret
  decreeNote    String? // référence / contexte (ex. « Revision trimestrielle »)
  createdAt     DateTime @default(now())

  @@index([fuelType, effectiveAt])
}

model SavedCalculation {
  id        String   @id @default(cuid())
  type      String
  label     String
  params    Json
  result    Json
  createdAt DateTime @default(now())
}

model Contribution {
  id              String   @id @default(cuid())
  stationCode     String?
  type            String // CLOSED | SERVICE_UNAVAILABLE | PRICE_ABNORMAL | PUMP_BROKEN | QUEUE | CLEANLINESS
  comment         String
  photoUrl        String?
  author          String
  status          String   @default("PENDING") // PENDING | VALIDATED | REJECTED
  validationCount Int      @default(0)
  lat             Float?
  lng             Float?
  createdAt       DateTime @default(now())
  // Date du dernier changement de statut (délai moyen de modération en back-office)
  updatedAt       DateTime?
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        String    @default("VIEWER") // ADMIN | NETWORK | COMMERCIAL | EXPANSION | VIEWER
  brandSlug   String?
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
}

// ---- Super Administration (T33) : pilotage SaaS de la plateforme —
// contrats des enseignes clientes, abonnements, facturation et journal
// d'audit des actions sensibles (impersonation, suspension, paiement).

model SaasContract {
  id           String       @id @default(cuid())
  brandSlug    String       @unique
  brandName    String
  color        String       @default("#059669")
  plan         String       @default("PRO") // ESSENTIEL | PRO | ENTERPRISE
  status       String       @default("ACTIF") // ESSAI | ACTIF | SUSPENDU | RESILIE
  startedAt    DateTime     @default(now())
  renewsAt     DateTime
  monthlyFee   Float        @default(0) // DT / mois (0 = essai)
  seats        Int          @default(5) // utilisateurs inclus
  stationQuota Int          @default(50)
  contactName  String
  contactEmail String
  contactPhone String       @default("")
  invoices     SaasInvoice[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model SaasInvoice {
  id         String      @id @default(cuid())
  contractId String
  contract   SaasContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number     String      @unique // ex. FCT-2025-0042
  issuedAt   DateTime
  dueAt      DateTime
  amount     Float // DT TTC
  status     String      @default("IMPAYEE") // PAYEE | IMPAYEE | RETARD
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
}

model AuditEvent {
  id        String   @id @default(cuid())
  kind      String   // AUTH | CONTRAT | FACTURE | UTILISATEUR | IMPERSONATION | SYSTEME
  message   String
  actor     String   @default("system") // e-mail de l'acteur
  brandSlug String?
  createdAt DateTime @default(now())
}

// ---- Module veille terrain (T28) : agents par zone, missions de contrôle
// des stations de son enseigne (fiche propriétaire) et missions de veille
// concurrentielle (fiche concurrent), rapports de visite remontés depuis
// l'application mobile « Espace agent ».

model FieldAgent {
  id        String    @id @default(cuid())
  code      String    @unique // code d'accès agent (connexion mobile)
  name      String
  phone     String    @default("")
  brandSlug String // enseigne employeur ("" = agent plateforme)
  zone      String // gouvernorat sous responsabilité
  active    Boolean   @default(true)
  missions  Mission[]
  reports   VisitReport[]
  createdAt DateTime  @default(now())
}

model Mission {
  id           String        @id @default(cuid())
  title        String
  type         String // CONTROLE | VEILLE_CONCURRENT
  brandSlug    String // enseigne commanditaire (fiche propriétaire)
  agentId      String?
  agent        FieldAgent?   @relation(fields: [agentId], references: [id])
  zone         String
  status       String        @default("PLANIFIEE") // PLANIFIEE | EN_COURS | TERMINEE | ANNULEE
  dueDate      DateTime?
  instructions String        @default("")
  tasks        MissionTask[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model MissionTask {
  id            String        @id @default(cuid())
  missionId     String
  mission       Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  stationCode   String? // station cible (mission de contrôle)
  stationName   String
  competitorSlug String? // enseigne observée (mission de veille)
  targetLabel   String // libellé lisible de la cible
  lat           Float?
  lng           Float?
  taskType      String        @default("CONTROLE_STATION") // CONTROLE_STATION | VEILLE_CONCURRENT
  status        String        @default("TODO") // TODO | FAITE | ANOMALIE
  order         Int           @default(0)
  reports       VisitReport[]
}

model VisitReport {
  id                   String       @id @default(cuid())
  taskId               String
  task                 MissionTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId              String
  agent                FieldAgent   @relation(fields: [agentId], references: [id])
  stationCode          String?
  // Prix observés en pompe (millimes) — veille concurrentielle ou anomalie
  gazolePrice          Int?
  essencePrice         Int?
  gplPrice             Int?
  queueMinutes         Int? // file d'attente constatée
  staffCount           Int? // personnel en poste
  cleanliness          Int? // propreté 1-5
  complianceScore      Int? // conformité enseigne 0-100
  anomalies            String       @default("") // anomalies constatées (texte libre)
  competitorPractices  String? // pratiques concurrentes observées
  notes                String       @default("")
  createdAt            DateTime     @default(now())
}
