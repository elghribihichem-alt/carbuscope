// CarbuScope — « Waze du Carburant » Tunisie
// Schema de données : stations, enseignes, services, alertes, mouvements,
// statistiques gouvernorats, axes routiers, projets d'infrastructure,
// avis, contributions communautaires, rapports et calculs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  color          String
  isIndependents Boolean   @default(false)
  stations       Station[]
}

model Station {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  brandId      String?
  brand        Brand?            @relation(fields: [brandId], references: [id])
  gouvernorat  String
  delegation   String
  address      String
  lat          Float
  lng          Float
  status       String            @default("ACTIVE") // ACTIVE | RENOVATION | PROJECT | CLOSED
  traffic      Int               @default(0) // véhicules/jour captifs
  open24       Boolean           @default(false)
  open7j       Boolean           @default(false)
  rating       Float             @default(0)
  reviewsCount Int               @default(0)
  photoUrl     String?
  lastVerified DateTime          @default(now())
  verifiedBy   String            @default("")
  services     StationService[]
  reviews      Review[]
  history      StationHistory[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Service {
  id       String            @id @default(cuid())
  slug     String            @unique
  name     String
  icon     String            @default("circle")
  stations StationService[]
}

model StationService {
  stationId String
  serviceId String
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([stationId, serviceId])
}

model StationHistory {
  id        String   @id @default(cuid())
  stationId String
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String
  newValue  String
  author    String
  source    String   @default("Enseigne") // Enseigne | Agent terrain | Utilisateur | Plateforme
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  stationId String
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  comment   String
  criteria  Json? // { propreté, accueil, rapidité, services }
  createdAt DateTime @default(now())
  // Réponse officielle de l'enseigne (C.2.6+ — gestion de la réputation)
  replyText String?
  repliedAt DateTime?
  repliedBy String?
}

model Alert {
  id          String   @id @default(cuid())
  type        String // OPENING | RENOVATION | REBRAND | INFRA | REGULATORY
  severity    String // CRITICAL | MEDIUM | INFO
  title       String
  description String
  brand       String
  gouvernorat String
  date        DateTime
  impact      String // Fort | Moyen | Faible
  stationCode String?
  read        Boolean  @default(false)
}

model Movement {
  id          String   @id @default(cuid())
  date        DateTime
  type        String // OPENING | RENOVATION | CLOSURE | REBRAND
  brand       String
  station     String
  gouvernorat String
  impact      String
}

model GovernoratStat {
  id               String @id @default(cuid())
  name             String @unique
  population       Int
  vehicles         Int
  motorizationRate Float
  avgFleetAge      Float
  delegationCount  Int
  // ---- Module Démographie (Phase 4 Super Admin, T35) : référence INS 2024
  // affichée en tête de groupe du tableau démographique — éditable depuis
  // le volet « Gouvernorats » (T37) avec traçabilité du dernier éditeur.
  isoCode          String? // « TN-11 »
  menPct           Float? // part des hommes (%)
  womenPct         Float? // part des femmes (%)
  areaKm2          Float? // superficie (km²)
  urbanPct         Float? // taux d'urbanisation (%)
  ruralPct         Float? // taux de ruralité (%)
  estimated        Boolean @default(false) // chiffres INS estimés (« est. »)
  updatedAt        DateTime? // dernière édition (volet Gouvernorats)
  updatedBy        String? // e-mail du dernier éditeur
}

// ---- Module Démographie (T37/T45, volet « Paramétrage ») : visibilité du
// module pour un utilisateur de la plateforme. Un enregistrement = un accès
// accordé. level GOUVERNORATS → vue gouvernorats ; DELEGATIONS → gouvernorats
// + délégations ; CITES (T45) → + drill-down sur les cités ; canEdit autorise
// l'édition en ligne (sinon lecture seule — l'édition des cités reste SA).
// L'effet est visible dans l'Observatoire B2B de l'utilisateur (onglet
// « Démographie » apparaissant après rechargement de la navigation).
model DemographicAccess {
  id        String   @id @default(cuid())
  userId    String   @unique
  level     String   @default("GOUVERNORATS") // GOUVERNORATS | DELEGATIONS | CITES
  canEdit   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ---- Module Démographie (Phase 4 Super Admin, T35) : une ligne par
// délégation (277 lignes, source INS 2024). Lignes éditables en ligne (clic)
// par le super-administrateur : population, taux urbain/rural et parc
// automobile par catégorie. Le niveau « cité » du découpage administratif
// (gouvernorat → délégation → cité) est géré par DemographicCite (T45).
model DemographicDelegation {
  id                  String    @id @default(cuid())
  gouvernorat         String // « Tunis » (clé vers GovernoratStat.name)
  isoCode             String // « TN-11 »
  delegation          String // « El Menzah »
  population          Int?
  urbanPct            Float?
  ruralPct            Float?
  vehiclesLight       Int? // voitures légères
  vehiclesUtility     Int? // utilitaires & pick-up
  vehiclesHeavy       Int? // poids lourds
  vehiclesBuses       Int? // autocars & bus
  vehiclesMotorcycles Int? // deux-roues motorisés
  updatedAt           DateTime?
  updatedBy           String? // e-mail du dernier éditeur

  @@unique([gouvernorat, delegation])
  @@index([gouvernorat])
}

// ---- Module Démographie (T45) : niveau « cité » du découpage administratif
// (gouvernorat → délégation → cité). Population et parc automobile par cité —
// alimentés en masse via l'import de la Super Administration.
model DemographicCite {
  id                  String    @id @default(cuid())
  gouvernorat         String
  delegation          String
  cite                String
  population          Int?
  urbanPct            Float?
  vehiclesLight       Int?
  vehiclesUtility     Int?
  vehiclesHeavy       Int?
  vehiclesBuses       Int?
  vehiclesMotorcycles Int?
  source              String    @default("INS 2024") // INS 2024 | Import SA
  updatedAt           DateTime?
  updatedBy           String?

  @@unique([gouvernorat, delegation, cite])
  @@index([gouvernorat, delegation])
}

model RoadAxis {
  id              String @id @default(cuid())
  code            String
  name            String
  type            String // AUTOROUTE | RN | GP
  tmj             Int // trafic moyen journalier
  heavyVehiclePct Float
  segments        Json // [[lng, lat], ...]
}

model InfraProject {
  id          String @id @default(cuid())
  name        String
  type        String // AUTOROUTE | ECHANGEUR | ZONE_INDUSTRIELLE | PORT | ROUTE
  status      String // CONSTRUCTION | PLANIFIE
  budget      String
  targetDate  String
  description String
  lat         Float
  lng         Float
}

model Report {
  id          String   @id @default(cuid())
  name        String
  type        String // CONCURRENCE | IMPLANTATION | PERFORMANCE | VEILLE
  period      String
  scope       String
  format      String // PDF | Excel | PowerPoint
  status      String   @default("GENERATED")
  generatedBy String
  sizeKb      Int      @default(0)
  createdAt   DateTime @default(now())
}

model ReportSchedule {
  id        String   @id @default(cuid())
  name      String
  type      String // WEEKLY | MONTHLY | REALTIME
  target    String
  channel   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Veille automatisée des notes (C.2.6+) : alerte email programmée déclenchée
// lorsqu'une station chute de seuil points (règle watchlist de /api/stats/reputation).
model WatchlistAlert {
  id              String    @id @default(cuid())
  brandSlug       String
  scope           String // "ALL" (toute la watchlist) ou code d'une station
  stationLabel    String // libellé lisible (nom de la station ou « Toute la watchlist »)
  thresholdPoints Float     @default(0.8)
  frequency       String // IMMEDIATE | DAILY | WEEKLY
  email           String
  active          Boolean   @default(true)
  triggerCount    Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
}

// Moteur périodique de veille (C.2.6+) : trace chaque passe d'évaluation des
// alertes programmées. En production : cron planifié ; en démo : passe
// déclenchable manuellement depuis le back-office + historique seedé.
model AlertRun {
  id              String   @id @default(cuid())
  ranAt           DateTime @default(now())
  mode            String   @default("MANUAL") // MANUAL | SCHEDULED
  brandsCovered   Int      @default(0)
  evaluatedAlerts Int      @default(0) // alertes dues évaluées contre la watchlist
  triggeredAlerts Int      @default(0) // alertes ayant déclenché un email
  skippedAlerts   Int      @default(0) // alertes non dues (fréquence déjà honorée)
  stationsFlagged Int      @default(0) // stations signalées, cumul des alertes déclenchées
  emailsQueued    Int      @default(0) // emails simulés mis en file
  durationMs      Int      @default(0)
  details         Json? // détail par alerte (statut, exemples, email tel qu'envoyé)
}

// Notifications in-app enseigne (C.2.6+) : écrites par le moteur de veille au
// moment où un email part, consultées depuis le portail (cloche + centre de
// notifications). Boucle de fermeture : email simulé + badge portail.
model Notification {
  id           String   @id @default(cuid())
  brandSlug    String
  kind         String   @default("WATCHLIST") // WATCHLIST | SYSTEM | DECREE | RELANCE (T43 : fraîcheur J+7)
  title        String
  body         String
  stationLabel String? // station ou périmètre concerné
  deltaPoints  Float? // chute constatée (pt)
  alertRunId   String? // passe du moteur à l'origine
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// Observatoire des prix du carburant (T22) : en Tunisie les prix pompe sont
// fixés par décret ministériel, identiques sur tout le territoire — la série
// historique trace chaque décret (prix pompe + marge détaillant réglementée).
// Alimente l'onglet B2B « Prix & marges », la bannière mobile B2C et la
// référence du signalement « Prix anormal » (B.2.5).
model FuelPrice {
  id            String   @id @default(cuid())
  fuelType      String // ESSENCE | GAZOLE | GPL
  priceMillimes Int // prix pompe, millimes/L (ou /kg pour GPL)
  marginMillimes Int // marge détaillant réglementée, millimes/L
  effectiveAt   DateTime // date d'application du décret
  decreeNote    String? // référence / contexte (ex. « Revision trimestrielle »)
  createdAt     DateTime @default(now())

  @@index([fuelType, effectiveAt])
}

model SavedCalculation {
  id        String   @id @default(cuid())
  type      String
  label     String
  params    Json
  result    Json
  createdAt DateTime @default(now())
}

model Contribution {
  id              String   @id @default(cuid())
  stationCode     String?
  type            String // CLOSED | SERVICE_UNAVAILABLE | PRICE_ABNORMAL | PUMP_BROKEN | QUEUE | CLEANLINESS
  comment         String
  photoUrl        String?
  author          String
  status          String   @default("PENDING") // PENDING | VALIDATED | REJECTED
  validationCount Int      @default(0)
  lat             Float?
  lng             Float?
  createdAt       DateTime @default(now())
  // Date du dernier changement de statut (délai moyen de modération en back-office)
  updatedAt       DateTime?
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    @default("VIEWER") // SUPER_ADMIN | ADMIN | NETWORK | COMMERCIAL | EXPANSION | VIEWER
  brandSlug    String?
  active       Boolean   @default(true)
  passwordHash String? // bcrypt — null = compte non initialisé (connexion refusée)
  totpSecret   String? // secret TOTP base32 (double authentification)
  totpEnabled  Boolean   @default(false) // 2FA active : la connexion exige un code à 6 chiffres
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// ---- Super Administration (T33) : pilotage SaaS de la plateforme —
// contrats des enseignes clientes, abonnements, facturation et journal
// d'audit des actions sensibles (impersonation, suspension, paiement).

model SaasContract {
  id           String       @id @default(cuid())
  brandSlug    String       @unique
  brandName    String
  color        String       @default("#059669")
  plan         String       @default("PRO") // ESSENTIEL | PRO | ENTERPRISE
  status       String       @default("ACTIF") // ESSAI | ACTIF | SUSPENDU | RESILIE
  startedAt    DateTime     @default(now())
  renewsAt     DateTime
  monthlyFee   Float        @default(0) // DT / mois (0 = essai)
  seats        Int          @default(5) // utilisateurs inclus
  stationQuota Int          @default(50)
  contactName  String
  contactEmail String
  contactPhone String       @default("")
  invoices     SaasInvoice[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ---- Catalogue des plans tarifaires SaaS (T32) : source de vérité des offres
// vendues aux enseignes. Les contrats référencent le code du plan
// (ESSENTIEL | PRO | ENTERPRISE) ; features FR séparées par « | ».

model SaasPlan {
  id            String   @id @default(cuid())
  code          String   @unique // ESSENTIEL | PRO | ENTERPRISE
  label         String
  monthlyFee    Int // DT / mois
  seatsIncluded Int // sièges utilisateurs inclus
  stationQuota  Int // quota de stations
  features      String // features FR séparées par « | »
  sortOrder     Int
  active        Boolean  @default(true)
}

model SaasInvoice {
  id         String      @id @default(cuid())
  contractId String
  contract   SaasContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number     String      @unique // ex. FCT-2025-0042
  issuedAt   DateTime
  dueAt      DateTime
  amount     Float // DT TTC
  status     String      @default("IMPAYEE") // PAYEE | IMPAYEE | RETARD
  paidAt     DateTime?
  // Relances d'échéance (T30) : combien de relances envoyées + dernière date
  reminderCount    Int       @default(0)
  lastReminderAt   DateTime?
  createdAt  DateTime     @default(now())
}

model AuditEvent {
  id        String   @id @default(cuid())
  kind      String   // AUTH | CONTRAT | FACTURE | UTILISATEUR | IMPERSONATION | SYSTEME | AGENT_IA | DEMOGRAPHIE
  message   String
  actor     String   @default("system") // e-mail de l'acteur
  brandSlug String?
  createdAt DateTime @default(now())
}

// ---- Agent IA interne (Phase 3 Super Admin) : tâches créées/exécutées par
// l'assistant IA de la plateforme (LLM serveur). Disponible d'abord pour la
// Super Administration ; ouverture progressive aux enseignes et à leur
// personnel via AiAgentBrandSetting / AiAgentUserSetting.

model AiTask {
  id          String    @id @default(cuid())
  title       String
  instruction String
  status      String    @default("ENREGISTREE") // ENREGISTREE | EN_COURS | TERMINEE | ECHEC
  result      String?
  error       String?
  launchedAt  DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  createdBy   String    @default("") // e-mail de l'auteur
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AiAgentBrandSetting {
  id        String   @id @default(cuid())
  brandSlug String   @unique
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AiAgentUserSetting {
  id        String   @id @default(cuid())
  userId    String   @unique
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ---- Paramètre cartographique (Phase 3 Super Admin) : délimitation de la
// zone de couverture (bounding box éditable). CarbuScope ne couvre que la
// Tunisie — cette zone borne le chargement cartographique pour éviter le
// poids et les zones hors pays inutiles.
model CartoBoundary {
  id        String   @id @default("zone-principale")
  name      String   @default("Zone de couverture — Tunisie")
  minLat    Float    @default(30.2)
  maxLat    Float    @default(37.4)
  minLng    Float    @default(7.5)
  maxLng    Float    @default(11.6)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---- Module veille terrain (T28) : agents par zone, missions de contrôle
// des stations de son enseigne (fiche propriétaire) et missions de veille
// concurrentielle (fiche concurrent), rapports de visite remontés depuis
// l'application mobile « Espace agent ».

model FieldAgent {
  id        String    @id @default(cuid())
  code      String    @unique // code d'accès agent (connexion mobile)
  name      String
  phone     String    @default("")
  brandSlug String // enseigne employeur ("" = agent plateforme)
  zone      String // gouvernorat sous responsabilité
  active    Boolean   @default(true)
  missions  Mission[]
  reports   VisitReport[]
  createdAt DateTime  @default(now())
}

model Mission {
  id           String        @id @default(cuid())
  title        String
  type         String // CONTROLE | VEILLE_CONCURRENT
  brandSlug    String // enseigne commanditaire (fiche propriétaire)
  agentId      String?
  agent        FieldAgent?   @relation(fields: [agentId], references: [id])
  zone         String
  status       String        @default("PLANIFIEE") // PLANIFIEE | EN_COURS | TERMINEE | ANNULEE
  dueDate      DateTime?
  instructions String        @default("")
  tasks        MissionTask[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model MissionTask {
  id            String        @id @default(cuid())
  missionId     String
  mission       Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  stationCode   String? // station cible (mission de contrôle)
  stationName   String
  competitorSlug String? // enseigne observée (mission de veille)
  targetLabel   String // libellé lisible de la cible
  lat           Float?
  lng           Float?
  taskType      String        @default("CONTROLE_STATION") // CONTROLE_STATION | VEILLE_CONCURRENT
  status        String        @default("TODO") // TODO | FAITE | ANOMALIE
  order         Int           @default(0)
  reports       VisitReport[]
}

// ---- Module Shadow Market (T44) : recensement, cartographie et analyse
// d'impact des points de vente informels de carburant (« vendeurs clandestins »
// — bidons bord de route, kiosques, camions-citernes pirates, stations pirate,
// garages). Ces points grignotent ~40 % du marché formel. Module accessible à
// la Super Administration (vision nationale) et aux enseignes (leurs pertes).

// Point de vente informel recensé sur le terrain.
model ShadowPoint {
  id            String              @id @default(cuid())
  code          String              @unique // « SM-26-0847 »
  typologyCode  String              // BIDONS | KIOSQUE | CAMION_CITERNE | STATION_PIRATE | GARAGE | EPICERIE
  status        String              @default("BRUT") // BRUT | VERIFIE | VALIDE | REJETE | DOUBLON
  gouvernorat   String
  delegation    String
  cite          String? // cité / quartier / lieu-dit
  lat           Float
  lng           Float
  volumeLJ      Int                 @default(0) // volume estimé litres/jour
  priceMillimes Int? // prix affiché (millimes/L, ex. 1 480 = 1,480 DT)
  photoUrl      String?
  notes         String              @default("")
  source        String              @default("AGENT") // AGENT | CONTROLEUR | AUDIT | CONTRIBUTION
  reporter      String              @default("") // nom de l'agent terrain
  brandThreat   String? // enseigne la plus menacée à proximité (slug, calc)
  firstSeenAt   DateTime            @default(now())
  lastCheckAt   DateTime            @default(now())
  active        Boolean             @default(true) // false = disparu / neutralisé
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  updates       ShadowPointUpdate[]
}

// Historique du cycle de vie d'un point : apparition, disparition,
// réapparition, changement de volume / prix / typologie, déplacement.
model ShadowPointUpdate {
  id       String      @id @default(cuid())
  pointId  String
  point    ShadowPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  kind     String // APPARITION | DISPARITION | REAPPARITION | VOLUME | PRIX | TYPE | DEPLACEMENT | STATUT
  oldValue String?
  newValue String?
  author   String      @default("")
  date     DateTime    @default(now())

  @@index([pointId, date])
}

// Catalogue extensible des typologies de points informels (modifiable depuis
// Paramètres → Typologies). Les recensements et calculs d'impact s'y réfèrent.
model ShadowTypology {
  id          String  @id @default(cuid())
  code        String  @unique
  label       String
  description String  @default("")
  icon        String  @default("circle") // nom d'icône lucide suggéré
  color       String  @default("#E53935")
  volumeLJ    Int     @default(200) // volume moyen indicative litres/jour
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

// Équipe d'audit terrain dédiée au recensement du marché parallèle.
model ShadowAuditor {
  id         String   @id @default(cuid())
  name       String
  zone       String // gouvernorat sous responsabilité
  brandSlug  String   @default("") // "" = équipe plateforme (multi-enseignes)
  phone      String   @default("")
  pointsDone Int      @default(0) // points recensés (crédités)
  rechecks   Int      @default(0) // re-vérifications effectuées
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// Calendrier des recensements : passages planifiés / effectués par équipe.
model ShadowCensusEvent {
  id              String   @id @default(cuid())
  teamLabel       String // ex. « Équipe Sud-Est »
  zone            String // gouvernorat ou délégation
  kind            String   @default("RECENSEMENT") // RECENSEMENT | RECHECK | VALIDATION
  date            DateTime
  pointsTargeted  Int      @default(0) // points prévus à couvrir
  pointsFound     Int      @default(0) // points constatés (nouveaux + confirmés)
  status          String   @default("PLANIFIE") // PLANIFIE | EN_COURS | TERMINE
}

// Configuration du module (rayons de cannibalisation, seuils d'alerte,
// notifications) — une seule ligne, éditable depuis Paramètres.
model ShadowConfig {
  id               String   @id @default("shadow-config")
  radiiM           String   @default("500,1000,2000") // cercles affichés (m, CSV)
  cannibRadiusM    Int      @default(2000) // rayon de cannibalisation principal
  redZoneThreshold Int      @default(5) // > N points dans 2 km = zone rouge
  lossRedTnd       Int      @default(20000) // perte mensuelle critique (DT)
  lossOrangeTnd    Int      @default(5000) // perte mensuelle modérée (DT)
  notifyRadiusM    Int      @default(500) // alerte nouveau point < X m d'une station
  notifyActive     Boolean  @default(true)
  marginTndPerL    Float    @default(0.2) // marge détaillant (DT/L) des pertes
  updatedAt        DateTime @updatedAt
}

// Série mensuelle nationale : points actifs, perte estimée — 12 mois glissants
// (saisonnalité Ramadan / été / rentrée visible).
model ShadowMonthlyStat {
  id           String  @id @default(cuid())
  month        String  @unique // « 2026-09 »
  activePoints Int     @default(0)
  newPoints    Int     @default(0)
  closedPoints Int     @default(0)
  estLossTnd   Int     @default(0)
  note         String? // contexte saisonnier
}

// Fil d'alertes du marché parallèle (nouveau point < 500 m d'une station,
// recrudescence d'une zone, danger incendie camion-citerne…).
model ShadowAlert {
  id          String   @id @default(cuid())
  severity    String // CRITICAL | MEDIUM | INFO → rouge / orange / jaune
  kind        String // NEW_POINTS | FIRE_RISK | SURGE | NEUTRALISE | DENSITE
  title       String
  detail      String
  zone        String
  stationCode String?
  stationName String?
  lossTnd     Int      @default(0) // perte mensuelle associée (DT)
  date        DateTime @default(now())
  read        Boolean  @default(false)
}

model VisitReport {
  id                   String       @id @default(cuid())
  taskId               String
  task                 MissionTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId              String
  agent                FieldAgent   @relation(fields: [agentId], references: [id])
  stationCode          String?
  // Prix observés en pompe (millimes) — veille concurrentielle ou anomalie
  gazolePrice          Int?
  essencePrice         Int?
  gplPrice             Int?
  queueMinutes         Int? // file d'attente constatée
  staffCount           Int? // personnel en poste
  cleanliness          Int? // propreté 1-5
  complianceScore      Int? // conformité enseigne 0-100
  anomalies            String       @default("") // anomalies constatées (texte libre)
  competitorPractices  String? // pratiques concurrentes observées
  notes                String       @default("")
  createdAt            DateTime     @default(now())
}
